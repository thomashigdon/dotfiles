function gmtime {
  date -d"@$1"
  TZ=ET date -d"@$1"
  date -u -d"@$1"
}

function h2d {
  echo $((16#$1))
}

function d2h {
  echo "obase=16; $1" | bc
}

function hgrep() {
  sed -n "1p;/$@/p"
}

